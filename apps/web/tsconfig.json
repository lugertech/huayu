{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite-plus/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "build",
    "vite.config.ts",
    "../../scripts/generate-quick-start-covers.ts"
  ]
}
